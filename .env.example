# ── Runtime ─────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ────────────────────────────
MONGODB_URI=mongodb://localhost:27017/bd-ecommerce

# ── Admin Auth ──────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
ADMIN_SEED_EMAIL=admin@store.com
ADMIN_SEED_PASSWORD=Admin@12345

# ── Steadfast ───────────────────────────
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=change-me-webhook-token

# ── SMS (optional for now) ──────────────
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=

# ── Frontend origin (CORS) ──────────────
CORS_ORIGIN=http://localhost:3000

# ── Public store info ───────────────────
STORE_NAME=BD Store
STORE_PHONE=01700000000
STORE_EMAIL=support@bdstore.com
STORE_ADDRESS=Dhaka, Bangladesh