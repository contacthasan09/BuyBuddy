@"
# ── API ─────────────────────────────────
# Point this at your backend. Use localhost for local dev, your
# deployed backend URL for production.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ── Site ────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=BD Store

# ── Server-side backend (used when NEXT_PUBLIC_API_URL is relative) ──
BACKEND_URL=http://localhost:5000/api
"@ | Out-File -Encoding utf8 frontend\.env.local.example